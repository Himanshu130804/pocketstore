PORT=5000
MONGO_URI=
JWT_SECRET=
JWT_REFRESH_SECRET=

SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

CLIENT_URL=http://localhost:5173

# SMS provider: mock (works immediately) or msg91 (real SMS after account setup)
SMS_PROVIDER=mock
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10

# Mock provider options
# Leave DEV_OTP empty to generate a new random OTP for every request.
DEV_OTP=
# Set true only if you want the OTP returned to the browser during local development.
EXPOSE_DEV_OTP=true

# MSG91 OTP configuration — add later, then set SMS_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Optional MSG91 Flow configuration for bill and order-status SMS
MSG91_FLOW_ID=
